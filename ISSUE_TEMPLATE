name: Team meeting
description: Weekly team meeting — agenda, prep, notes
title: "Team meeting — YYYY-MM-DD"
labels: ["meeting", "team-meeting"]
body:
  - type: input
    id: when
    attributes:
      label: When
      placeholder: "Tuesday 23 Sept, 13:00, room ___"
    validations:
      required: true

  - type: input
    id: sprint
    attributes:
      label: Sprint / week
      placeholder: "Sprint 3, week 5"

  - type: markdown
    attributes:
      value: |
        ## Prep — due the evening before

        Everyone posts a comment with three lines:
        **Done** since last meeting (link issues) · **Blocked** on ·
        **Next** — what you're picking up.

        Tick your box when you've posted. An empty box at meeting time
        is not a problem to fix in the meeting; it's the first thing we
        talk about.

  - type: checkboxes
    id: prep
    attributes:
      label: Prep posted
      options:
        - label: Addi
        - label: Arvid
        - label: Silje
        - label: Hugo
        - label: Greipur

  - type: textarea
    id: agenda
    attributes:
      label: Agenda
      description: Anyone can edit this issue to add an item. Put your name on it.
      value: |
        **Standing**
        - [ ] Demo — anything working since last week
        - [ ] Board review: blocked and stale items
        - [ ] Sprint goal — still realistic?

        **Raised**
        - [ ] (item) — @who

        **Workshop / deep dive**
        - [ ] (topic, if any — say how long it needs)
    validations:
      required: true

  - type: textarea
    id: decisions
    attributes:
      label: Decisions
      description: Filled during the meeting. Include the reasoning, not just the outcome.
      value: |
        -

  - type: textarea
    id: actions
    attributes:
      label: Actions
      description: >
        Every action becomes a real issue before we leave the room,
        with an assignee and an iteration. Paste the links here.
      value: |
        - [ ] #

  - type: textarea
    id: carried
    attributes:
      label: Open / carried forward
      value: |
        -
